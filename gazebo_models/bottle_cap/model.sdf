<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="bottle_cap">
    <!-- <static>false</static> -->
    <link name="link">
      <inertial>
        <mass>0.5</mass>  <!-- 设置质量（单位：千克）-->
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://bottle_cap/meshes/bottle_cap.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://bottle_cap/meshes/bottle_cap.dae</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>

